{
  "name": "fast-systemone-compaction",
  "version": "0.5.0",
  "description": "Continuous, verbatim context compaction for LLM agents guided by a System One (Jev) model or fixed rules.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && npm run typecheck:tools",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "replay": "tsx tools/replay/run.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
